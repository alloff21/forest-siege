mergeInto(LibraryManager.library,{ForestReady:function(){if(window.YaGames){window.YaGames.init().then(function(sdk){window.ysdk=sdk;if(sdk.features&&sdk.features.LoadingAPI)sdk.features.LoadingAPI.ready();}).catch(console.error);}else{var s=document.createElement('script');s.src='/sdk.js';s.onload=function(){window.YaGames.init().then(function(sdk){window.ysdk=sdk;if(sdk.features&&sdk.features.LoadingAPI)sdk.features.LoadingAPI.ready();}).catch(console.error);};document.head.appendChild(s);}}});
